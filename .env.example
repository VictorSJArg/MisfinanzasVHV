DATABASE_URL=
DIRECT_URL=

# Installation identity. Use "victor" in the current app and "esposa" in the second app.
NEXT_PUBLIC_APP_PROFILE=victor
NEXT_PUBLIC_APP_NAME=Mis Finanzas VHV

# Shared token used by n8n when calling /api/assistant.
ASSISTANT_WEBHOOK_SECRET=
CRON_SECRET=

# Optional allowlist for the dedicated WhatsApp number/user that can operate the assistant.
# Use digits only, or comma-separated digits for more than one number.
ASSISTANT_ALLOWED_PHONE=
N8N_ALERT_WEBHOOK_URL=
N8N_ALERT_WEBHOOK_TOKEN=
APP_BASE_URL=
N8N_PERSONAL_SCHEDULER_WEBHOOK_URL=
N8N_PERSONAL_SCHEDULER_TOKEN=

# Dedicated Evolution instance for this installation.
EVOLUTION_BASE_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=

# Optional Basic Auth for the web app UI.
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=
