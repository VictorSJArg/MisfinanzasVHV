{
  "name": "Mis Finanzas VHV - Scheduler Alertas Personales",
  "nodes": [
    {
      "parameters": {
        "content": "Configurar en el nodo Config:\n\n- SCHEDULER_TOKEN: mismo valor que N8N_PERSONAL_SCHEDULER_TOKEN en Vercel.\n\nLa app llama al Webhook cuando crea o reprograma un recordatorio/evento/mensaje. Este workflow responde enseguida, espera hasta scheduledFor y llama al callback de la app.",
        "height": 320,
        "width": 520,
        "color": 4
      },
      "id": "b7409d16-38f0-40a6-8ce5-000000000001",
      "name": "Notas",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -760,
        -360
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mis-finanzas-personal-scheduler",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b7409d16-38f0-40a6-8ce5-000000000002",
      "name": "Webhook Scheduler",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -760,
        80
      ],
      "webhookId": "mis-finanzas-personal-scheduler"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-token",
              "name": "SCHEDULER_TOKEN",
              "value": "COMPLETAR_TOKEN_COMPARTIDO_CON_LA_APP",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b7409d16-38f0-40a6-8ce5-000000000003",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -520,
        80
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $('Webhook Scheduler').first().json;\nconst config = $('Config').first().json;\nconst body = input.body || input;\nconst auth = input.headers?.authorization || input.headers?.Authorization || '';\nif (config.SCHEDULER_TOKEN && auth !== `Bearer ${config.SCHEDULER_TOKEN}`) {\n  throw new Error('No autorizado');\n}\nconst scheduledFor = new Date(body.scheduledFor);\nif (!body.scheduledAlertId) throw new Error('scheduledAlertId requerido');\nif (!body.callbackUrl) throw new Error('callbackUrl requerido');\nif (Number.isNaN(scheduledFor.getTime())) throw new Error('scheduledFor invalido');\nconst waitSeconds = Math.max(1, Math.ceil((scheduledFor.getTime() - Date.now()) / 1000));\nreturn [{\n  json: {\n    ...body,\n    waitSeconds,\n    receivedAt: new Date().toISOString(),\n    schedulerAccepted: true,\n    token: config.SCHEDULER_TOKEN\n  }\n}];"
      },
      "id": "b7409d16-38f0-40a6-8ce5-000000000004",
      "name": "Preparar Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        80
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, jobId: $json.scheduledAlertId, waitSeconds: $json.waitSeconds } }}",
        "options": {}
      },
      "id": "b7409d16-38f0-40a6-8ce5-000000000005",
      "name": "Responder a App",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -40,
        -40
      ]
    },
    {
      "parameters": {
        "amount": "={{ $json.waitSeconds }}"
      },
      "id": "b7409d16-38f0-40a6-8ce5-000000000006",
      "name": "Esperar Hasta Horario",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        -40,
        180
      ],
      "webhookId": "wait-mis-finanzas-personal-scheduler"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.callbackUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ `Bearer ${$json.token}` }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "scheduledAlertId",
              "value": "={{ $json.scheduledAlertId }}"
            },
            {
              "name": "sourceType",
              "value": "={{ $json.sourceType }}"
            },
            {
              "name": "sourceId",
              "value": "={{ $json.sourceId }}"
            },
            {
              "name": "version",
              "value": "={{ $json.version }}"
            }
          ]
        },
        "options": {
          "redirect": {
            "redirect": {}
          }
        }
      },
      "id": "b7409d16-38f0-40a6-8ce5-000000000007",
      "name": "Disparar Callback App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        180
      ]
    }
  ],
  "pinData": {},
  "connections": {
