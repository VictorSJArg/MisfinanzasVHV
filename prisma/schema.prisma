generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  currency  String   @default("ARS")
  createdAt DateTime @default(now())

  transactions Transaction[]
  categories   Category[]
  budgets      Budget[]
  accounts     Account[]
  alertPreference AlertPreference?
  alertDispatchLogs AlertDispatchLog[]
  alertDismissals AlertDismissal[]
  alertExclusions AlertExclusion[]
  personalContacts PersonalContact[]
  personalReminders PersonalReminder[]
  personalTasks PersonalTask[]
  personalEvents PersonalEvent[]
  outboundMessages OutboundMessage[]
  assistantActionLogs AssistantActionLog[]
  assistantScheduledAlerts AssistantScheduledAlert[]
}

model Account {
  id      String @id @default(uuid())
  name    String
  type    String // CASH, BANK, WALLET, CREDIT
  balance Decimal @default(0)
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  transactions Transaction[]
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String   // INCOME, EXPENSE
  icon      String?
  color     String?
  parentId  String?
  sortOrder Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  transactions Transaction[]
  budgets      Budget[]
  children    Category[] @relation("CategoryHierarchy")
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])

  @@unique([userId, name, type])
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Decimal
  date        DateTime
  description String?
  type        String   // INCOME, EXPENSE, TRANSFER
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  status      String   @default("PAID") // PAID, PENDING, CANCELLED

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, categoryId])
}

model Budget {
  id         String   @id @default(uuid())
  amount     Decimal
  period     String   // MONTHLY, WEEKLY
  year       Int
  month      Int?
  
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, year, month, categoryId])
}

// Tarjeta de Crédito
model CreditCard {
  id        String   @id @default(uuid())
  name      String   // Nombre de la tarjeta (ej: "VISA BSJ")
  bank      String   // Banco emisor
  lastFour  String?  // Últimos 4 dígitos
  
  userId    String
  createdAt DateTime @default(now())
  
  statements CreditCardStatement[]
}

// Resumen mensual de la tarjeta
model CreditCardStatement {
  id           String   @id @default(uuid())
  closingDate  DateTime // Fecha de cierre
  dueDate      DateTime // Fecha de vencimiento (cuando se paga)
  totalAmount  Decimal  // Saldo total del resumen
  minimumPayment Decimal? // Pago mínimo
  
  creditCardId String
  creditCard   CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  
  items        CreditCardItem[]
  
  createdAt    DateTime @default(now())
  
  @@unique([creditCardId, closingDate])
}

// Ítem individual del resumen (cada consumo)
model CreditCardItem {
  id              String   @id @default(uuid())
  date            DateTime // Fecha del consumo
  description     String   // Descripción (ej: "NETFLIX", "COMBUSTIBLES BARCELO")
  amount          Decimal  // Monto en pesos
  amountUSD       Decimal? // Monto en dólares (si aplica)
  
  // Cuotas
  installmentCurrent Int?  // Cuota actual (ej: 4 de C.04/06)
  installmentTotal   Int?  // Total de cuotas (ej: 6 de C.04/06)
  installmentAmount  Decimal? // Monto por cuota
  
  // Clasificación
  itemType        String   @default("PURCHASE") // PURCHASE, RECURRING, PAYMENT, FEE, TAX
  isRecurring     Boolean  @default(false)      // Is this a recurring expense?
  category        String?  // Categoría: COMBUSTIBLE, ALIMENTOS, SERVICIOS, ENTRETENIMIENTO, ROPA, SALUD, OTROS
  observations    String?  // User notes/observations
  
  
  // Proyecciones
  includeInProjection Boolean @default(true)    // Si se incluye en las proyecciones
  projectedAmount     Decimal?                  // Monto manual para proyección
  
  statementId     String
  statement       CreditCardStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
}

model ProjectionStatus {
  id          String   @id @default(uuid())
  referenceId String   // ID of the CreditCardItem or source entity
  date        DateTime // The specific projected date
  status      String   // "PAID", "CANCELLED", "PENDING"
  updatedAt   DateTime @updatedAt

  @@unique([referenceId, date])
}

// Override de monto para un mes específico de una proyección
model ProjectionMonthlyOverride {
  id          String   @id @default(uuid())
  itemId      String   // ID del CreditCardItem
  yearMonth   String   // Formato "YYYY-MM" para identificar el mes
  amount      Decimal  // Monto override para este mes específico
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([itemId, yearMonth])
}

model AssistantSession {
  id        String   @id @default(uuid())
  phone     String   @unique
  action    String
  payload   Json
  createdAt DateTime @default(now())
}

model AssistantHistory {
  id        String   @id @default(uuid())
  phone     String   @unique
  messages  Json     // [ { role: 'user', content: '...' }, { role: 'assistant', content: '...' } ]
  updatedAt DateTime @updatedAt
}

model AlertPreference {
  id         String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  enabled     Boolean  @default(true)
  phone       String?
  daysBefore  Int      @default(1)
  alertWindowDays Int   @default(30)
  notifyHour  Int      @default(8)
  timezone    String   @default("America/Argentina/Buenos_Aires")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AlertDispatchLog {
  id           String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  alertKey      String
  scheduledFor  DateTime
  channel       String   @default("WHATSAPP")
  createdAt     DateTime @default(now())

  @@unique([channel, alertKey, scheduledFor])
  @@index([userId, scheduledFor])
}

model AlertDismissal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  alertKey    String
  sourceType  String
  sourceId    String
  title       String
  dueDate     DateTime
  createdAt   DateTime @default(now())

  @@unique([userId, alertKey])
  @@index([userId, dueDate])
}

model AlertExclusion {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  categoryId  String
  description String   @default("")
  createdAt   DateTime @default(now())

  @@unique([userId, categoryId, description])
  @@index([userId, categoryId])
}

model PersonalContact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  alias     String?
  relation  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outboundMessages OutboundMessage[]

  @@unique([userId, phone])
  @@index([userId, name])
}

model PersonalReminder {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  remindAt    DateTime
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  channel     String    @default("WHATSAPP") // WHATSAPP, APP
  recurrence  String?   // NONE, DAILY, WEEKLY, MONTHLY, YEARLY, CUSTOM
  status      String    @default("PENDING") // PENDING, DONE, CANCELLED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, remindAt])
  @@index([userId, status])
}

model PersonalTask {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueAt       DateTime?
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, DONE, CANCELLED
  tags        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, dueAt])
  @@index([userId, status])
}

model PersonalEvent {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  location     String?
  startsAt     DateTime
  endsAt       DateTime?
  participants String?
  status       String    @default("SCHEDULED") // SCHEDULED, DONE, CANCELLED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, startsAt])
  @@index([userId, status])
}

model OutboundMessage {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     PersonalContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  phone       String
  contactName String?
  text        String
  scheduledAt DateTime?
  sentAt      DateTime?
  status      String           @default("DRAFT") // DRAFT, SCHEDULED, SENT, FAILED, CANCELLED
  error       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, scheduledAt])
  @@index([userId, status])
}

model AssistantActionLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String   @default("APP") // APP, WHATSAPP, CHAT, CRON
  action    String
  status    String   @default("SUCCESS") // SUCCESS, FAILED, PENDING_CONFIRMATION
  summary   String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, action])
}

model AssistantScheduledAlert {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType  String   // REMINDER, EVENT, MESSAGE
  sourceId    String
  scheduledFor DateTime
  timezone    String   @default("America/Argentina/Buenos_Aires")
  version     Int      @default(1)
  status      String   @default("SCHEDULED") // SCHEDULED, SENT, SKIPPED, FAILED, CANCELLED
  provider    String   @default("N8N")
  externalJobId String?
  sentAt      DateTime?
  error       String?
  payload     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sourceType, sourceId, version])
  @@index([userId, scheduledFor])
  @@index([sourceType, sourceId])
  @@index([status, scheduledFor])
}
